#!/bin/bash 

. /etc/profile
. /gemsoft/etc/profile.d/gea.sh

#
# Add user apache to group software so the webserver can rw gea's files.
#

/usr/sbin/usermod -a -G software apache

#
# Update configurations, create and initialize databases, create directories, files, and symlinks.
#

cd $GEA_BASE/run
ln -fs $EPICS/extensions/bin/$EPICS_HOST_ARCH/ArchiveDataServer ArchiveDataServer.cgi
ln -fs $EPICS/extensions/bin/$EPICS_HOST_ARCH/ArchiveExport ArchiveExport

directories="$GEA_TMP $GEA_DATA/wwwdata/sysMon/status $GEA_DATA/wwwdata/sysMon/html $GEA_DATA/wwwdata/m1SurfacePlots $GEA_DATA/wwwdata/niriData $GEA_DATA/wwwdata/weeklyPlans $GEA_DATA/wwwdata/daily $GEA_BASE/.matplotlib"
for directory in $directories; do
    mkdir -p $directory
    chown software:software $directory
    chmod 777 $directory
done

files="$GEA_DATA/wwwdata/sysMon/status/info.log"
for file in $files; do
    cp /dev/null $file > /dev/null
    chown software:software $file
    chmod 666 $file
done

ln -fs /gemsoft/etc/gea/labs $GEA_BASE/labs
chown software:software $GEA_BASE/labs

ln -fs $GEA_DATA/wwwdata $GEA_BASE/wwwdata
chown software:software $GEA_BASE/wwwdata

chmod 755 $GEA_BASE/www_media/scripts
chown software:software $GEA_BASE/www_media/scripts
rm -f $GEA_BASE/www_media/scripts/sideMenu.js

chmod 755 $GEA_BASE/etc/httpd
chown software:software $GEA_BASE/etc/httpd
rm -f $GEA_BASE/etc/httpd/httpd_env.conf

#
# Hack alert: /etc/init.d/httpd has a broken chkconfig line, resulting it httpd not
# being properly started on boot. The following will ensure that httpd gets started,
# and will also ensure it's started _after_ gea.
#

if ! grep -q gemini /etc/ssh/sshd_config ; then
    echo "Group gemini not in /etc/ssh/sshd_config."
fi

HTTPD_ENV_CONF=$GEA_BASE/etc/httpd/httpd_env.conf

echo "#"                                                       >  $HTTPD_ENV_CONF
echo "# AUTO GENERATED FILE. DO NOT EDIT."                     >> $HTTPD_ENV_CONF
echo "# Regenerate via \"$GEMINI_TOP/etc/init.d/gea start\"."  >> $HTTPD_ENV_CONF
echo "#"                                                       >> $HTTPD_ENV_CONF

echo "SetEnv EPICS_BASE         $EPICS_BASE"                   >> $HTTPD_ENV_CONF
echo "SetEnv EPICS_CA_ADDR_LIST \"$EPICS_CA_ADDR_LIST\""       >> $HTTPD_ENV_CONF
echo "SetEnv GEA_BASE           $GEA_BASE"                     >> $HTTPD_ENV_CONF
echo "SetEnv GEA_CONF           $GEA_CONF"                     >> $HTTPD_ENV_CONF
echo "SetEnv GEA_HOST           `hostname`"                    >> $HTTPD_ENV_CONF
echo "SetEnv GEA_DATA           $GEA_DATA"                     >> $HTTPD_ENV_CONF
echo "SetEnv GEA_TMP            $GEA_TMP"                      >> $HTTPD_ENV_CONF
echo "SetEnv HOME               $GEA_BASE"                     >> $HTTPD_ENV_CONF
echo "SetEnv GEA_VERSION        $GEA_VERSION"                  >> $HTTPD_ENV_CONF
echo "SetEnv GEA_RELEASE        $GEA_RELEASE"                  >> $HTTPD_ENV_CONF
echo "SetEnv GEMINI_SITE        $GEMINI_SITE"                  >> $HTTPD_ENV_CONF
echo "SetEnv SERVERCONFIG       $SERVERCONFIG"                 >> $HTTPD_ENV_CONF
echo "SetEnv PYTHONPATH         $PYTHONPATH"                   >> $HTTPD_ENV_CONF
echo "SetEnv LD_LIBRARY_PATH    $LD_LIBRARY_PATH"              >> $HTTPD_ENV_CONF

systemctl enable httpd
systemctl start  httpd


#
# Install crontab for software:
#

CRONFILE=/tmp/cron.tmp
CRONFILETMPL=$GEA_BASE/etc/crontab.$GEMINI_SITE.template

echo "#"                                                                         > $CRONFILE
echo "# DO NOT EDIT THIS FILE - edit the master crontab.$GEMINI_SITE.template." >> $CRONFILE
echo "# restart GEA. Then check crontab.$GEMINI_SITE.template back into SVN."   >> $CRONFILE
echo "#"                                                                        >> $CRONFILE
echo                                                                            >> $CRONFILE
cat $CRONFILETMPL | while read LINE; do echo "echo \"$LINE\""; done | sh        >> $CRONFILE

crontab -u software /tmp/cron.tmp
rm -f /tmp/cron.tmp

#
# Initialize the sql database:
#

systemctl enable mariadb
systemctl start  mariadb

echo "DROP DATABASE sysMon;"					        	            | mysql --user=root > /dev/null 2>&1
echo "DROP USER 'software'@'localhost';"			             		    | mysql --user=root > /dev/null 2>&1
echo "GRANT ALL ON *.* to 'software'@'localhost' IDENTIFIED BY 'software';"                 | mysql --user=root
echo "GRANT ALL ON *.* to 'software'@'mkogeanorth.hi.gemini.edu' IDENTIFIED BY 'software';" | mysql --user=root
echo "GRANT ALL ON *.* to 'software'@'cpogeasouth.cl.gemini.edu' IDENTIFIED BY 'software';" | mysql --user=root
echo "CREATE DATABASE sysMon;"                                                 		    | mysql --user=root

#
# Build sysMonitor MySQL database from text config files (Why? I don't know). Mysqld has
# to be running for this to work, and we have to be root to start mysqld. Ugh.
# 

$GEA_BASE/sysMon/sysMonitor.py dbSync

#
# Generate left side menus
#

menuCreator.py

update_config all
