#!/usr/bin/perl

#
# Sample code to show how to use geautils package.
#

BEGIN {
    push(@INC, "$ENV{'GEA_BASE'}/lib");
}

use archiveconfig;
use geautils qw(run $config $gea_base $gea_data $gea_root $gea_host $debug $doall $nope);

sub handle_daemon($)
{
    my ($d_name) = @_;
}

sub handle_engine($$)
{
    my ($d_name, $e_name) = @_;
    my ($port) = $config->{daemon}{$d_name}{engine}{$e_name}{port};

    print("read url: http://$gea_host:$port/stop\n") if $debug | $nope;

    if (! $nope) {
        my @doc = read_URL($gea_host, $port, "stop");
        print join("\n", @doc) if $debug;
    }
    sleep 1 unless $nope;		# Wait for engine to die.
    print("rm $gea_data$gea_root/$d_name/$e_name/archive_active.lck\n") if $debug | $nope;
    my $rmd = unlink("$gea_data$gea_root/$d_name/$e_name/archive_active.lck") unless $nope;
    print("Lockfile removed\n") if $rmd;
}

run(\&handle_daemon, \&handle_engine);

print "Warning: Engine will be automatically restarted by ArchiveDaemon.\n";

